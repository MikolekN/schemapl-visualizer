# Copy to .env (which is gitignored) and fill in.

# When set the services are reached over the public route, which needs credentials.
# When unset they are reached by their internal names.
RUN_LOCAL=

# Authentication for upstream services.
SERVICE_USER=
SERVICE_PASSWORD=

# How much the service logs. DEBUG adds request and response headers
# of every upstream call (the Authorization value stays hidden).
LOG_LEVEL=INFO
