// The official layout: acts as published in Dziennik Ustaw and Monitor Polski,
// and its accessible version.
//
// Paragraph geometry follows the RCL Word template the journals are typeset
// with (rcl-styles.typ, generated by scripts/rcl_styles.py); page furniture
// (masthead, running header, footnotes) follows the published PDFs.
//
// The accessible version (sys.inputs "uklad": "dostepny") is the same document
// made easier to read: large print (18 pt text, every measure of the layout
// scaled with it, no text smaller) in a sans-serif face, as large-print
// guidelines advise, 1.5 line spacing, text set flush left without hyphenation,
// links underlined, stronger table rules, and its structure tagged for screen
// readers (PDF/UA-1): the act's title, its chapters and annexes are headings.

#import "rcl-styles.typ": rcl-styles

#let _dostepny = sys.inputs.at("uklad", default: "urzedowy") == "dostepny"
#let _skala = if _dostepny { 1.8 } else { 1 } // 10 pt text -> 18 pt
#let _druk-min = if _dostepny { 18pt } else { 0pt } // notes and small print included
// deep quotes keep a readable line in large print
#let _wciecie-max = if _dostepny { 200pt } else { none }

// Times New Roman, as published; Liberation Serif has the same metrics.
#let _fonty-urzedowe = ("Times New Roman", "Liberation Serif", "TeX Gyre Termes")
// The accessible version's face: Atkinson Hyperlegible, drawn for readers with
// low vision (Braille Institute), else other clear sans-serif faces.
#let _fonty = if _dostepny {
  ("Atkinson Hyperlegible Next", "Atkinson Hyperlegible", "Verdana", "Arial", "Liberation Sans", "DejaVu Sans")
} else { _fonty-urzedowe }
// Formulas: Word's Cambria Math, else a Times-like math font.
#let _fonty-matematyczne = ("Cambria Math", "TeX Gyre Termes Math", "New Computer Modern Math")

// Word sets the announcement part of an obwieszczenie with a 25 mm left margin
// and its styles pull back by this much; on the 18 mm page it is what they keep.
#let _przesuniecie-obwieszczenia = 19.85pt * _skala

#let _gora = 74.9pt // top margin: the first baseline lands where Word puts it

#let _dzienniki = (
  DU: (naglowek: "Dziennik Ustaw", wiersz-1: "DZIENNIK USTAW", wiersz-2: "RZECZYPOSPOLITEJ POLSKIEJ",
       styl-1: "RCL_Tytuł DU 1", styl-2: "RCL_Tytuł DU 2"),
  MP: (naglowek: "Monitor Polski", wiersz-1: "MONITOR POLSKI",
       wiersz-2: "DZIENNIK URZĘDOWY RZECZYPOSPOLITEJ POLSKIEJ",
       styl-1: "RCL_Tytuł MP 1", styl-2: "RCL_Tytuł MP 2"),
)

// The cover letter of a bill: not part of the RCL template.
#let _normalny = rcl-styles.at("RCL_Normalny")
#let _style-dodatkowe = (
  "PROJ_WINIETA": (.._normalny, caps: true, bold: true),
  "PROJ_KADENCJA": (.._normalny, after: 12pt),
  "PROJ_DRUK": (.._normalny, align: "right", bold: true),
  "PROJ_MIEJSCE": (.._normalny, align: "right", before: 12pt, after: 12pt),
  "PROJ_ADRESAT": (.._normalny, align: "right", bold: true),
  "PROJ_PODPISUJACY": (.._normalny, align: "right"),
  // a table cell's text: Word's default style, with the 2 pt below that keeps
  // the text off the border in the publications
  "KOMORKA": (.._normalny, after: 2pt),
  "OPIS_GRAFIKI": (.._normalny, align: "center", before: 2pt, after: 4pt),
)

// How the publications use a style when it differs from the template: the
// centred table text (column titles) is set without spacing in most of them.
#let _korekty = (
  "TEKST_w_TABELI_WYŚRODKOWANY": (before: 0pt, after: 0pt),
)

// A style as the RCL template defines it.
#let _styl-rcl(nazwa) = {
  let s = rcl-styles.at(nazwa, default: _style-dodatkowe.at(nazwa, default: _normalny))
  s + _korekty.at(nazwa, default: (:))
}

// A style as this version sets it: in large print, every measure scaled.
#let _styl(nazwa) = {
  let s = _styl-rcl(nazwa)
  if not _dostepny { return s }
  let x = _skala
  (
    ..s,
    size: calc.max(s.size * x, _druk-min),
    left: s.left * x,
    right: s.right * x,
    first: s.first * x,
    before: s.before * x,
    after: s.after * x,
    tracking: s.tracking * x,
    line: if s.line-rule == "auto" { s.line } else { s.line * x },
  )
}

// Space above a paragraph. Quoted (amended) paragraphs get 6 pt in RCL's
// typesetting - the value the published acts most often carry - rather than
// their style's 4 pt.
#let _przed(styl) = {
  let s = _styl(styl)
  if styl.starts-with(regex("^(Z|ZZ|Z_LIT|Z_TIR|Z_2TIR)/")) { calc.max(s.before, 6pt * _skala) } else { s.before }
}

// Times New Roman's descent: Word puts a line's extra height above the text.
#let _opadanie = 0.216

// Distance between baselines for a Word line-spacing rule; 1.5 lines at least in large print.
#let _skok(s) = {
  let pojedynczy = s.size * 1.15
  let skok = if s.line-rule == "auto" { pojedynczy * s.line } else if s.line-rule == "exact" { s.line } else {
    calc.max(s.line, pojedynczy)
  }
  if _dostepny { calc.max(skok, s.size * 1.5) } else { skok }
}

// A formula's legend: the symbol, the dash 1.5 cm and the explanation 2 cm from
// where the symbol starts, as the publications tab them.
#let _legenda = (kreska: 42.5pt * _skala, tekst: 56.7pt * _skala)

// -- paragraphs -------------------------------------------------------------------

// One paragraph in an RCL style. The gap above is the larger of the previous
// paragraph's "after" and this one's "before", as measured in the published
// PDFs (none between "contextual" paragraphs of one style). An article's
// marker ("Art. 5.") leads the marker of its first unit ("1.").
#let akapit(
  styl,
  oznaczenie: none,
  artykul: none,
  poziom: none,
  rola: none,
  glebokosc: 0,
  poprzedni: none,
  sekcja: none,
  z-nastepnym: false,
  z-przypisem: false,
  przed-przypisem: false,
  tresc,
) = {
  let s = _styl(styl)
  let oznaczenie = if artykul == none { oznaczenie } else if oznaczenie == none { artykul } else {
    artykul + [ ] + oznaczenie
  }
  let przed = _przed(styl)
  let odstep = przed
  if poprzedni == "POCZATEK" { // the document's first paragraph: no space above
    odstep = 0pt
  } else if poprzedni != none {
    odstep = if s.contextual and poprzedni == styl { 0pt } else { calc.max(przed, _styl(poprzedni).after) }
  }
  let legenda = rola == "legenda"
  let lewy = s.left + if sekcja == "obwieszczenie" { _przesuniecie-obwieszczenia } else { 0pt }
  // a negative first-line indent hangs the first line out, with or without a marker (as in Word)
  let wysuniecie = if s.first < 0pt { -s.first } else { 0pt }
  if legenda {
    lewy += s.first + _legenda.tekst // the explanation's column
    wysuniecie = if oznaczenie != none { _legenda.tekst } else { 0pt }
  }
  if _wciecie-max != none { lewy = calc.min(lewy, _wciecie-max) }
  let wciecie = if s.first > 0pt { s.first } else { 0pt }
  let tekst = if s.caps { upper(tresc) } else { tresc }
  let wiersz = if oznaczenie == none { tekst } else if legenda {
    context {
      if measure(oznaczenie).width + 2pt < _legenda.kreska { box(width: _legenda.kreska, oznaczenie) } else {
        oznaczenie + h(0.4em)
      }
    }
    box(width: _legenda.tekst - _legenda.kreska, [–])
    tekst
  } else if wysuniecie > 0pt {
    // the marker hangs; a long one pushes the text along, like Word's tab
    context {
      if measure(oznaczenie).width + 1pt < wysuniecie { box(width: wysuniecie, oznaczenie) } else {
        oznaczenie + h(0.4em)
      }
    }
    tekst
  } else { oznaczenie + [~] + tekst }
  block(
    width: 100%,
    above: odstep,
    below: 0pt,
    // Typst would move a kept block to the next page but leave a long footnote
    // behind, before its call: a paragraph with a footnote is not kept with the
    // next - nor, in large print (where notes outrun pages), the one before it
    sticky: (s.keep-next or z-nastepnym) and not z-przypisem and not (przed-przypisem and _dostepny),
    breakable: not s.keep-lines,
    inset: (left: calc.max(lewy - wysuniecie, 0pt), right: s.right),
    {
      // Word's line: as tall as the line spacing, the text standing on its bottom
      let opadanie = _opadanie * s.size
      set text(
        size: s.size,
        weight: if s.bold { "bold" } else { "regular" },
        style: if s.italic { "italic" } else { "normal" },
        tracking: s.tracking,
        top-edge: _skok(s) - opadanie,
        bottom-edge: -opadanie,
      )
      // a footnote call or an index does not make its line taller
      show super: set text(top-edge: 0.8em, bottom-edge: -0.2em)
      show sub: set text(top-edge: 0.8em, bottom-edge: -0.2em)
      set align(if s.align == "center" { center } else if s.align == "right" { right } else { left })
      // an explicit paragraph: lone inline content in a block is not one (Typst >= 0.13);
      // large print is set flush left: justified lines open uneven gaps between words
      par(
        justify: s.align == "justify" and not _dostepny,
        leading: 0pt,
        first-line-indent: (amount: wciecie, all: true),
        hanging-indent: wysuniecie,
        spacing: 0pt,
        wiersz,
      )
    },
  )
}

// A heading: the act's title, a chapter, an annex - an entry in the outline,
// titled by the profile (its lines' text without the notes Typst would add).
// The official version gives it a bookmark and prints its lines; the
// accessible one makes the lines a heading a screen reader announces, its
// bookmark following it so the units under it nest under the bookmark.
#let naglowek(poziom: 1, tytul: none, tresc) = if tytul == none {
  heading(level: poziom, outlined: true, bookmarked: true, tresc)
} else if _dostepny {
  heading(level: poziom, outlined: true, bookmarked: false, tresc)
  pdf.artifact(heading(level: poziom, outlined: false, bookmarked: true, tytul))
} else {
  pdf.artifact(heading(level: poziom, outlined: false, bookmarked: true, tytul))
  tresc
}

#let nowa-strona() = pagebreak(weak: true)

// A unit's entry in the PDF's bookmarks: a heading that shows nothing
// (``dokument`` hides headings that are not outlined); an article's too.
#let zakladka(poziom, tytul, artykul: false) = pdf.artifact(
  heading(level: poziom, outlined: false, bookmarked: true, tytul),
)

// -- formulas and graphics ----------------------------------------------------------

// A formula set by Typst from the act's MathML; ``opis`` reads it aloud.
#let wzor(opis, rownanie, wyswietlany: false) = math.equation(
  block: false,
  alt: opis,
  if wyswietlany { math.display(rownanie.body) } else { rownanie.body },
)

#let _ramki = if _dostepny { (thin: 1pt, medium: 2pt) } else { (thin: 0.5pt, medium: 1pt) }

// A picture: an SVG drawn as it is (scaled down to the line if wider), or the
// framed place of a picture kept in a separate file - named inside the frame
// unless its caption follows.
#let grafika(opis, plik: none, svg: none, szerokosc: none, wysokosc: none, podpisana: false) = {
  if svg != none {
    let rozmiar(wymiar) = if wymiar == none { auto } else { wymiar }
    // boxed: an image alone would end the paragraph it stands in
    box(image(bytes(svg), format: "svg", alt: opis, width: rozmiar(szerokosc), height: rozmiar(wysokosc)))
  } else {
    box(width: 100%, layout(obszar => {
      let szer = if szerokosc == none { 50% * obszar.width } else if type(szerokosc) == ratio {
        szerokosc * obszar.width
      } else { szerokosc }
      let wys = if wysokosc == none or type(wysokosc) == ratio { 0.6 * szer } else { wysokosc }
      let nazwa = if podpisana { none } else { align(center + horizon, text(size: calc.max(8pt, _druk-min), opis)) }
      align(center, rect(width: szer, height: wys, stroke: _ramki.thin, nazwa))
    }))
  }
}

// -- tables -------------------------------------------------------------------------

#let _margines-komorki = 5.4pt * _skala // Word's default cell margin (0.19 cm), none above or below
#let _pion = (top: top, middle: horizon, bottom: bottom)

// Column widths the way Word fits a full-width table to its text: every column
// gets at least its longest word, and the room left is shared in proportion to
// how much more each column's text would need to stay on one line.
// komorki: the cells as the profile places them (x, kolumny, slowa, akapity);
// stale: a fixed ratio or none per column.
#let _kolumny(komorki, liczba, dostepna, stale) = {
  // a paragraph's text on one line, in its style
  let wiersz(styl, tekst) = {
    let s = _styl(styl)
    let tekst = text(size: s.size, weight: if s.bold { "bold" } else { "regular" }, tracking: s.tracking, tekst)
    measure(tekst).width + s.left + calc.max(s.first, 0pt) + s.right
  }
  let najmniej = range(liczba).map(_ => 0pt)
  let najwiecej = range(liczba).map(_ => 0pt)
  let wymiary(k) = {
    let slowo = calc.max(0pt, ..k.slowa.map(s => measure(text(hyphenate: false, s)).width))
    let tekst = calc.max(0pt, ..k.akapity.map(((styl, tekst)) => wiersz(styl, tekst)))
    (slowo + 2 * _margines-komorki, calc.max(tekst, slowo) + 2 * _margines-komorki)
  }
  for k in komorki.filter(k => k.kolumny == 1) {
    let (min, max) = wymiary(k)
    najmniej.at(k.x) = calc.max(najmniej.at(k.x), min)
    najwiecej.at(k.x) = calc.max(najwiecej.at(k.x), max)
  }
  // a cell spanning columns widens them evenly if it needs more than they give
  for k in komorki.filter(k => k.kolumny > 1) {
    let (min, max) = wymiary(k)
    let zakres = range(k.x, calc.min(k.x + k.kolumny, liczba))
    let brak-min = min - zakres.map(i => najmniej.at(i)).sum()
    let brak-max = max - zakres.map(i => najwiecej.at(i)).sum()
    for i in zakres {
      if brak-min > 0pt { najmniej.at(i) += brak-min / zakres.len() }
      if brak-max > 0pt { najwiecej.at(i) += brak-max / zakres.len() }
    }
  }
  let wolne = range(liczba).filter(i => stale.at(i) == none)
  let miejsce = dostepna - range(liczba).filter(i => stale.at(i) != none).map(i => stale.at(i) * dostepna).sum(default: 0pt)
  let min-suma = wolne.map(i => najmniej.at(i)).sum(default: 0pt)
  let max-suma = wolne.map(i => najwiecej.at(i)).sum(default: 0pt)
  range(liczba).map(i => {
    if stale.at(i) != none { stale.at(i) * dostepna } else if max-suma == 0pt { miejsce / wolne.len() } else if max-suma <= miejsce {
      najwiecej.at(i) / max-suma * miejsce
    } else if min-suma <= miejsce {
      najmniej.at(i) + (najwiecej.at(i) - najmniej.at(i)) / (max-suma - min-suma) * (miejsce - min-suma)
    } else { najmniej.at(i) / min-suma * miejsce }
  })
}

// A table: cells placed by the profile (x, y, spans), the leading header rows
// repeated on every page when the act marks them so.
#let tabela(kolumny: 1, naglowek: 0, powtorz: false, szerokosc: none, stale: none, poprzedni: none, komorki) = {
  let stale = if stale == none { range(kolumny).map(_ => none) } else { stale }
  let komorka(k) = table.cell(
    x: k.x,
    y: k.y,
    colspan: k.kolumny,
    rowspan: k.wiersze,
    align: _pion.at(k.pion, default: top),
    // column titles get room above and below, as their rows' set height gives them
    inset: if k.naglowek { (x: _margines-komorki, y: 4pt * _skala) } else { auto },
    breakable: not k.niedzielic,
    stroke: k.ramki.pairs().map(((bok, ramka)) => (bok, _ramki.at(ramka, default: none))).to-dict(),
    {
      // large print leaves narrow columns: a long word is divided rather than cut off
      set text(hyphenate: true) if _dostepny
      // Word keeps the space around a cell's paragraphs; Typst would drop it
      if k.pierwszy != none { v(_przed(k.pierwszy)) }
      k.tresc
      if k.ostatni != none { v(_styl(k.ostatni).after) }
    },
  )
  block(above: if poprzedni == none { 0pt } else { _styl(poprzedni).after }, below: 0pt, layout(obszar => {
    let dostepna = if szerokosc == none { obszar.width } else { szerokosc * obszar.width }
    let tabela = table(
      columns: _kolumny(komorki, kolumny, dostepna, stale),
      inset: (x: _margines-komorki, y: 0pt),
      stroke: _ramki.thin,
      ..if naglowek > 0 { (table.header(repeat: powtorz, ..komorki.filter(k => k.y < naglowek).map(komorka)),) },
      ..komorki.filter(k => k.y >= naglowek).map(komorka),
    )
    if szerokosc == none { tabela } else { align(center, tabela) }
  }))
}

// -- running text -------------------------------------------------------------------

#let pogrubienie(tresc) = strong(tresc)
#let kursywa(tresc) = emph(tresc)
#let gorny(tresc) = super(tresc)  // raised as in Word (set in dokument)
#let dolny(tresc) = sub(tresc)
#let wersaliki(tresc) = upper(tresc)
#let rozstrzelone(tresc) = text(tracking: 0.25em, tresc)
#let petit(tresc) = if _dostepny { tresc } else { text(size: 0.85em, tresc) } // large print: one size
// Links stand out in the colour of the HTML view's links; in large print also
// underlined, in a darker blue (8.6:1 contrast on white). A link to a provision
// of the act itself goes to its anchor; one the layout has no anchor for stays text.
#let _kolor-odeslania = if _dostepny { rgb("#1e40af") } else { rgb("#2563eb") }
#let odeslanie(adres, tresc) = {
  let wyglad = text(fill: _kolor-odeslania, if _dostepny { underline(offset: 0.15em, tresc) } else { tresc })
  let odsylacz = link(adres, wyglad)
  if type(adres) == label { context if query(adres).len() > 0 { odsylacz } else { tresc } } else { odsylacz }
}
// Where a unit the act refers to begins (invisible).
#let kotwica(nazwa) = [#metadata(nazwa)#label(nazwa)]
// A footnote marked with the act's own symbol: "1)", "*)".
#let przypis(symbol, etykieta, tresc) = [#footnote(numbering: (..n) => symbol + ")", tresc)#label(etykieta)]
// Another call of a footnote, marked with its symbol (a reference has its own numbering).
#let odsylacz(etykieta, symbol: none) = footnote(
  label(etykieta),
  numbering: if symbol == none { "1)" } else { (..n) => symbol + ")" },
)
// A heading's footnote: the heading carries its call (``odsylacz``) and the note
// stands, unseen and taking no room, right after it - Typst does not divide a
// heading between pages, and a note longer than the page's rest would carry the
// heading away from it.
#let przypis-naglowka(symbol, etykieta, tresc) = block(
  height: 0pt,
  above: 0pt,
  below: 0pt,
  box(width: 0pt, hide(przypis(symbol, etykieta, tresc))),
)

// A note as printed at the foot of the page: its marker raised in the hanging indent.
#let _wpis-przypisu(numer, tresc) = {
  let s = _styl("ODNOŚNIK")
  set text(size: s.size)
  par(
    justify: not _dostepny,
    leading: calc.max(_skok(s) - s.size, 0pt),
    hanging-indent: -s.first,
    first-line-indent: 0pt,
    spacing: 0pt,
    [#box(width: -s.first, super(size: 6pt * _skala, numer))#tresc],
  )
}

// In large print the room under the rule is part of it: a note continued from
// the page before would start right on the rule (spacing below it, as the
// official version has, is dropped there; its notes rarely run that long).
#let _kreska-przypisow = block(
  inset: (bottom: if _dostepny { 5pt * _skala } else { 0pt }),
  below: if _dostepny { 0pt } else { 5pt },
  line(length: 144pt * _skala, stroke: 0.48pt * _skala),
)

// The act's notes that have no place in its text: under its text, set as notes.
#let odnosniki-aktu(..odnosniki) = block(above: 12pt * _skala, breakable: true, {
  _kreska-przypisow
  for (symbol, tresc) in odnosniki.pos() { _wpis-przypisu(symbol + ")", tresc) }
})

// -- page ---------------------------------------------------------------------------

// The emblem as the journals print it (taken from a published issue), its size there.
#let _godlo = pdf.artifact(image("godlo.png", width: 74.8pt, height: 83.9pt))

// The first page's masthead, positioned as in the published PDFs (baselines in
// page coordinates, measured from them). It is the same in large print, where
// the date and the position are set at the text's size, and keeps the
// journal's face whatever the text is set in: it is the journal's sign.
#let _winieta(dziennik, miejsce-data, pozycja, obwieszczenie) = {
  let s1 = _styl-rcl(dziennik.styl-1)
  let s2 = _styl-rcl(dziennik.styl-2)
  let rozmiar = calc.max(14pt, _druk-min)
  let na-linii(baseline, rozmiar, tresc) = place(top + left, dy: baseline - rozmiar - _gora, tresc)
  // the first line is set without the style's tracking, as the published mastheads are
  let wiersz(s, tekst, tracking) = pad(left: s.left, box(width: 500pt, text(size: s.size, tracking: tracking, tekst)))
  set text(font: _fonty-urzedowe, top-edge: 1em, bottom-edge: 0em)
  place(top + left, dx: 3pt, dy: 53pt - _gora, _godlo)
  na-linii(85pt, s1.size, wiersz(s1, dziennik.wiersz-1, 0pt))
  na-linii(126.3pt, s2.size, wiersz(s2, dziennik.wiersz-2, s2.tracking))
  place(top + left, dx: s1.left - 1pt, dy: 138pt - _gora, line(length: 100% - s1.left + 1pt, stroke: 0.96pt))
  if miejsce-data != none {
    na-linii(176.2pt, rozmiar, block(width: 100%, align(center, text(size: rozmiar, miejsce-data))))
  }
  if pozycja != none {
    na-linii(204.3pt, rozmiar, block(width: 100%, align(center, text(size: rozmiar, pozycja))))
  }
  // an announcement's text starts higher (its masthead uses the "TJ" styles). A
  // block, not spacing: after spacing at the top of the page, Typst would move a
  // title whose footnote outruns the page onward, leaving the note behind. The
  // document's first paragraph has no space above it (``akapit``), as in Word.
  block(width: 100%, height: 243.3pt - _gora - if obwieszczenie { 6pt } else { 0pt }, above: 0pt, below: 0pt)
}

// The whole document: page, fonts, header, footnotes, then the masthead and the body.
#let dokument(dziennik: none, miejsce-data: none, pozycja: none, tytul: none, obwieszczenie: false, body) = {
  let gazeta = if dziennik == none { none } else { _dzienniki.at(dziennik, default: none) }
  set document(title: tytul)
  // no punctuation hanging into the margin: Word keeps lines inside it;
  // large print divides no words
  set text(font: _fonty, size: 10pt * _skala, lang: "pl", region: "PL", hyphenate: if _dostepny { false } else { auto },
           overhang: false, top-edge: 0.8em, bottom-edge: -0.2em)
  set par(spacing: 0pt, leading: 2pt * _skala)
  set page(
    paper: "a4",
    margin: (top: _gora, bottom: 51pt, left: 51pt, right: 51pt),
    header-ascent: 14pt,
    header: context {
      if gazeta != none and counter(page).get().first() > 1 {
        set text(size: 10pt * _skala)
        block(width: 100%, stroke: (bottom: 0.96pt), inset: (bottom: 3pt), grid(
          columns: (1fr, auto, 1fr),
          align(left, gazeta.naglowek),
          [– #counter(page).display() –],
          align(right, if pozycja != none { pozycja } else { [] }),
        ))
      }
    },
  )
  show heading: it => it.body
  show heading.where(outlined: false): none // bookmarks only (after the rule above: applied first)
  show math.equation: set text(font: _fonty-matematyczne)
  // Word's superscript: two thirds of the size, raised by a third
  set super(typographic: false, size: 0.6em, baseline: -0.33em)
  set footnote.entry(
    separator: _kreska-przypisow,
    clearance: 8pt * _skala,
    gap: 0pt,
    indent: 0pt,
  )
  show footnote.entry: it => context {
    _wpis-przypisu(numbering(it.note.numbering, ..counter(footnote).at(it.note.location())), it.note.body)
  }
  if gazeta != none { _winieta(gazeta, miejsce-data, pozycja, obwieszczenie) }
  body
}
